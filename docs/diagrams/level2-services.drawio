<mxfile host="drawio"><diagram name="Level 2 services"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Rihla — Level 2 services (business rules)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="700" height="36" as="geometry"/></mxCell><mxCell id="sa" value="SeatAvailabilityCalculator&lt;br&gt;&lt;small&gt;pure PHP, no database&lt;/small&gt;" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="92" as="geometry"/></mxCell><mxCell id="sa0" value="+ takenPerLeg(legCount, bookings): int[]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;html=1;fontSize=13;" vertex="1" parent="sa"><mxGeometry x="0" y="40" width="320" height="26" as="geometry"/></mxCell><mxCell id="sa1" value="+ freeSeats(offered, bookings, from, to): int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;html=1;fontSize=13;" vertex="1" parent="sa"><mxGeometry x="0" y="66" width="320" height="26" as="geometry"/></mxCell><mxCell id="bs" value="BookingService" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="320" height="104" as="geometry"/></mxCell><mxCell id="bs0" value="+ book(trip, from, to, seats, passenger): Booking" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;html=1;fontSize=13;" vertex="1" parent="bs"><mxGeometry x="0" y="26" width="320" height="26" as="geometry"/></mxCell><mxCell id="bs1" value="transaction + SELEC