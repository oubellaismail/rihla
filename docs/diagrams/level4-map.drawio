=#FDECEC;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="280" height="44" as="geometry"/></mxCell><mxCell id="r5c2" value="yes: green free · orange 1 left · red full" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="330" width="280" height="44" as="geometry"/></mxCell><mxCell id="st" value="How a trip page is built (no external call except tiles)" style="text;html=1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="414" width="700" height="30" as="geometry"/></mxCell><mxCell id="v_u" value="Viewer" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="170" height="48" as="geometry"/></mxCell><mxCell id="v_u_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="502" as="sourcePoint"/><mxPoint x="125" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v_c" value="TripController" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="454" width="170" height="48" as="geometry"/></mxCell><mxCell id="v_c_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="502" as="sourcePoint"/><mxPoint x="355" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v_m" value="TripMapData" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="454" width="170" height="48" as="geometry"/></mxCell><mxCell id="v_m_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="502" as="sourcePoint"/><mxPoint x="585" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v_t" value="Twig" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="454" width="170" height="48" as="geometry"/></mxCell><mxCell id="v_t_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815" y="502" as="sourcePoint"/><mxPoint x="815" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v_l" value="Leaflet&lt;br&gt;trip-map" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="454" width="170" height="48" as="geometry"/></mxCell><mxCell id="v_l_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045" y="502" as="sourcePoint"/><mxPoint x="1045" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s1" value="GET /trips/12?from=1&amp;amp;to=2" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="534" as="sourcePoint"/><mxPoint x="355" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s2" value="for(trip, viewer, 1, 2)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="574" as="sourcePoint"/><mxPoint x="585" y="574" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s3" value="is viewer the driver, or a passenger with a CONFIRMED booking?&lt;br&gt;→ exact points only then (same rule as the voters)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="405" y="604" width="360" height="36" as="geometry"/></mxCell><mxCell id="s4" value="{stops[city, lat, lng], legs[geometry, occupancy?], highlight, pins?}" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="585" y="664" as="sourcePoint"/><mxPoint x="355" y="664" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s5" value="render, JSON in data-trip-map-value" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="704" as="sourcePoint"/><mxPoint x="815" y="704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s6" value="page loaded → draw tiles, lines, markers" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815" y="744" as="sourcePoint"/><mxPoint x="1045" y="744" as="targetPoint"/></mxGeometry></mxCell><mxCell id="pr" value="&lt;b&gt;Privacy is decided on the server&lt;/b&gt;&lt;br&gt;Hiding a pin with CSS/JS would still leak it in the page source. TripMapData does not put the coordinates in the JSON at all. A functional test checks the HTML of a visitor contains no meeting-point coordinates." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="454" width="300" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Data model"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Level 4 data model changes" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="city" value="City  (unchanged)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="330" height="112" as="geometry"/></mxCell><mxCell id="city0" value="name" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="city"><mxGeometry x="0" y="40" width="330" height="24" as="geometry"/></mxCell><mxCell id="city1" value="latitude: ?float   (already filled by fixtures)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="city"><mxGeometry x="0" y="64" width="330" height="24" as="geometry"/></mxCell><mxCell id="city2" value="longitude: ?float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="city"><mxGeometry x="0" y="88" width="330" height="24" as="geometry"/></mxCell><mxCell id="stop" value="TripStop" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="440" y="70" width="380" height="232" as="geometry"/></mxCell><mxCell id="stop0" value="city, position, departureAt, meetingPoint (text)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="40" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop1" value="legPriceToNext" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="64" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop2" value="legDistanceKmToNext: ?int   (exists, now filled)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="88" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop3" value="+ meetingLatitude: ?float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="112" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop4" value="+ meetingLongitude: ?float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="136" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop5" value="+ legDurationMinToNext: ?int" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="160" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop6" value="+ legGeometry: ?text   (encoded polyline)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="stop"><mxGeometry x="0" y="184" width="380" height="24" as="geometry"/></mxCell><mxCell id="stop7" value="all new columns nullable → old trips stay valid" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="stop"><mxGeometry x="0" y="208" width="380" height="24" as="geometry"/></mxCell><mxCell id="dm1" value="*  →  1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;" edge="1" parent="1" source="stop" target="city"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="vo" value="Value objects (src/Model, not stored)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="380" height="136" as="geometry"/></mxCell><mxCell id="vo0" value="GeoPlace(label, latitude, longitude)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="vo"><mxGeometry x="0" y="40" width="380" height="24" as="geometry"/></mxCell><mxCell id="vo1" value="RouteLeg(distanceKm, durationMin, geometry)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="vo"><mxGeometry x="0" y="64" width="380" height="24" as="geometry"/></mxCell><mxCell id="vo2" value="Route(legs: list&amp;lt;RouteLeg&amp;gt;)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="vo"><mxGeometry x="0" y="88" width="380" height="24" as="geometry"/></mxCell><mxCell id="vo3" value="TripMap(stops, legs, highlight, pins, occupancy)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="vo"><mxGeometry x="0" y="112" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc" value="Services" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="380" height="208" as="geometry"/></mxCell><mxCell id="svc0" value="GeoProvider (interface)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="svc"><mxGeometry x="0" y="40" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc1" value="NominatimClient implements it" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="svc"><mxGeometry x="0" y="64" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc2" value="RouteProvider (interface)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="svc"><mxGeometry x="0" y="88" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc3" value="OsrmClient implements it" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="svc"><mxGeometry x="0" y="112" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc4" value="both return null when the API fails" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="svc"><mxGeometry x="0" y="136" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc5" value="PriceSuggester · ArrivalTimeSuggester" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="svc"><mxGeometry x="0" y="160" width="380" height="24" as="geometry"/></mxCell><mxCell id="svc6" value="RouteEnricher · TripMapData" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="svc"><mxGeometry x="0" y="184" width="380" height="24" as="geometry"/></mxCell><mxCell id="mig" value="&lt;b&gt;One migration&lt;/b&gt;&lt;br&gt;ALTER TABLE trip_stop ADD meeting_latitude, meeting_longitude, leg_duration_min_to_next, leg_geometry (all NULL).&lt;br&gt;&lt;br&gt;&lt;b&gt;Fixtures&lt;/b&gt;&lt;br&gt;demo trips get real meeting points and routes saved from OSRM once, so the demo works offline." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="330" height="200" as="geometry"/></mxCell><mxCell id="why" value="&lt;b&gt;Why interfaces&lt;/b&gt;&lt;br&gt;Tests swap the real APIs for fakes; another provider (Google, Mapbox) could replace OSM later without touching the rules." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="330" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="When an API fails"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="When an external API fails" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="f0" value="Need a place or a route" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3B2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="200" height="50" as="geometry"/></mxCell><mxCell id="f1" value="In geo.cache?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="200" height="90" as="geometry"/></mxCell><mxCell id="f2" value="Use cached answer&lt;br&gt;(no call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="185" width="200" height="60" as="geometry"/></mxCell><mxCell id="f3" value="Rate limit OK?&lt;br&gt;(1/s Nominatim, 30/min user)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="200" height="100" as="geometry"/></mxCell><mxCell id="f4" value="Call API (timeout 3 s)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA3B2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="460" width="200" height="50" as="geometry"/></mxCell><mxCell id="f5" value="200 with a result?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="200" height="90" as="geometry"/></mxCell><mxCell id="f6" value="Store in cache 30 days&lt;br&gt;Return result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="200" height="60" as="geometry"/></mxCell><mxCell id="f7" value="Log a warning · return &lt;b&gt;null&lt;/b&gt;&lt;br&gt;(no exception reaches the user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#EBA3A3;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="220" height="60" as="geometry"/></mxCell><mxCell id="fe0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f0" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f1" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe4" value="no (API: 429)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f3" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe7" value="timeout · 5xx · empty" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="f5" target="f7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eff" value="What the user sees when it is null" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="470" height="232" as="geometry"/></mxCell><mxCell id="eff0" value="Publish page: no suggested price / time," style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="40" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff1" value="note « Suggestions indisponibles pour le moment. »" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="eff"><mxGeometry x="0" y="64" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff2" value="Address search: « Adresse introuvable, placez le point" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="88" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff3" value="sur la carte ou écrivez-le. »" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="eff"><mxGeometry x="0" y="112" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff4" value="Publish still works: RouteEnricher leaves legs null" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="136" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff5" value="Trip page: straight dashed lines between city coords" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="160" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff6" value="Tiles down: grey map, the stop timeline is still there" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="184" width="470" height="24" as="geometry"/></mxCell><mxCell id="eff7" value="JS disabled: no map, every page still usable" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="eff"><mxGeometry x="0" y="208" width="470" height="24" as="geometry"/></mxCell><mxCell id="tst" value="&lt;b&gt;Tests for this page&lt;/b&gt;&lt;br&gt;• MockHttpClient returns 503 / timeout → client returns null&lt;br&gt;• Publishing with a failing RouteProvider still saves the trip&lt;br&gt;• Trip page with null geometry renders (straight lines)&lt;br&gt;• Second identical call does not hit the API (cache)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="470" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
