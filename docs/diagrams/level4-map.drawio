<mxfile host="drawio"><diagram name="Components"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Rihla — Level 4 components (map, geocoding, routing)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="zb" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="560" as="geometry"/></mxCell><mxCell id="leaf" value="Leaflet 1.9 (importmap, no build)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="290" height="208" as="geometry"/></mxCell><mxCell id="leaf0" value="OpenStreetMap tiles + attribution" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="leaf"><mxGeometry x="0" y="40" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf1" value="Stimulus: trip-map (read only)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="leaf"><mxGeometry x="0" y="64" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf2" value="Stimulus: publish-map (click, live route)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="leaf"><mxGeometry x="0" y="88" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf3" value="Stimulus: driver-map (legs by occupancy)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="leaf"><mxGeometry x="0" y="112" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf4" value="data comes from data-* attributes (JSON)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="leaf"><mxGeometry x="0" y="136" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf5" value="or from our /api endpoints — never from" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="leaf"><mxGeometry x="0" y="160" width="290" height="24" as="geometry"/></mxCell><mxCell id="leaf6" value="Nominatim / OSRM directly" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="leaf"><mxGeometry x="0" y="184" width="290" height="24" as="geometry"/></mxCell><mxCell id="ext" value="&lt;b&gt;Links out (no API key)&lt;/b&gt;&lt;br&gt;Google Maps: maps/dir/?api=1&amp;amp;destination=lat,lng&lt;br&gt;Waze: waze.com/ul?ll=lat,lng&amp;amp;navigate=yes&lt;br&gt;&lt;i&gt;Only shown when the exact point is visible.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="290" height="110" as="geometry"/></mxCell><mxCell id="fb" value="&lt;b&gt;Map is an extra&lt;/b&gt;&lt;br&gt;The stop timeline stays on every page. If tiles or JS fail, the page still works." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="290" height="80" as="geometry"/></mxCell><mxCell id="zs" value="Symfony (new code in yellow)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;dashed=1;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="560" height="560" as="geometry"/></mxCell><mxCell id="api" value="MapApiController  (JSON, ROLE_USER)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="250" height="184" as="geometry"/></mxCell><mxCell id="api0" value="GET /api/geocode?q=…  → places[]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="api"><mxGeometry x="0" y="40" width="250" height="24" as="geometry"/></mxCell><mxCell id="api1" value="GET /api/reverse?lat=&amp;amp;lng=  → label" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="api"><mxGeometry x="0" y="64" width="250" height="24" as="geometry"/></mxCell><mxCell id="api2" value="GET /api/route?points=lat,lng;lat,lng;…" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="api"><mxGeometry x="0" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="api3" value="→ legs[{distanceKm, durationMin," style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="api"><mxGeometry x="0" y="112" width="250" height="24" as="geometry"/></mxCell><mxCell id="api4" value="suggestedPrice, geometry}]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="api"><mxGeometry x="0" y="136" width="250" height="24" as="geometry"/></mxCell><mxCell id="api5" value="RateLimiter: 30 calls / min / user" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="api"><mxGeometry x="0" y="160" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients" value="HTTP clients (scoped)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="100" width="250" height="184" as="geometry"/></mxCell><mxCell id="clients0" value="NominatimClient" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="clients"><mxGeometry x="0" y="40" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients1" value="OsrmClient" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="clients"><mxGeometry x="0" y="64" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients2" value="User-Agent: Rihla/1.0 (+repo URL)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="clients"><mxGeometry x="0" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients3" value="timeout 3 s, no retry" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="clients"><mxGeometry x="0" y="112" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients4" value="Nominatim: ≤ 1 request / s (limiter)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="clients"><mxGeometry x="0" y="136" width="250" height="24" as="geometry"/></mxCell><mxCell id="clients5" value="cache pool geo.cache, 30 days" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="clients"><mxGeometry x="0" y="160" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules" value="Pure rules (unit tested)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="250" height="184" as="geometry"/></mxCell><mxCell id="rules0" value="PriceSuggester::forDistance(km): int MAD" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="rules"><mxGeometry x="0" y="40" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules1" value="0.35 MAD/km, rounded to 5 MAD" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="rules"><mxGeometry x="0" y="64" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules2" value="ArrivalTimeSuggester::after(t, min)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="rules"><mxGeometry x="0" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules3" value="+ 10 min pause, rounded to 5 min" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="rules"><mxGeometry x="0" y="112" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules4" value="TripMapData::for(trip, viewer, from, to)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="rules"><mxGeometry x="0" y="136" width="250" height="24" as="geometry"/></mxCell><mxCell id="rules5" value="decides which points the viewer gets" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="rules"><mxGeometry x="0" y="160" width="250" height="24" as="geometry"/></mxCell><mxCell id="enr" value="RouteEnricher" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=40;horizontalStack=0;resizeParent=1;resizeParentMax=0;collapsible=0;html=1;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="330" width="250" height="136" as="geometry"/></mxCell><mxCell id="enr0" value="called by TripPublisher after the checks" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="enr"><mxGeometry x="0" y="40" width="250" height="24" as="geometry"/></mxCell><mxCell id="enr1" value="fills distance, duration, geometry" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;" vertex="1" parent="enr"><mxGeometry x="0" y="64" width="250" height="24" as="geometry"/></mxCell><mxCell id="enr2" value="per leg; nulls if OSRM fails" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="enr"><mxGeometry x="0" y="88" width="250" height="24" as="geometry"/></mxCell><mxCell id="enr3" value="(publishing never fails because of it)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=12;fontStyle=2;fontColor=#5A626E;" vertex="1" parent="enr"><mxGeometry x="0" y="112" width="250" height="24" as="geometry"/></mxCell><mxCell id="ctl" value="&lt;b&gt;Existing controllers, small changes&lt;/b&gt;&lt;br&gt;TripController, BookingController, DriverTripController, TripPublishController pass &lt;code&gt;TripMapData&lt;/code&gt; to Twig." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="535" width="520" height="66" as="geometry"/></mxCell><mxCell id="zx" value="External services (free, no key)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#FDF0E7;strokeColor=#E8A57F;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="60" width="260" height="380" as="geometry"/></mxCell><mxCell id="nom" value="&lt;b&gt;Nominatim&lt;/b&gt; (OSM)&lt;br&gt;address ⇄ coordinates&lt;br&gt;&lt;i&gt;Policy: 1 req/s, real User-Agent, cache results, no autocomplete on every key press.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="100" width="230" height="110" as="geometry"/></mxCell><mxCell id="osrm" value="&lt;b&gt;OSRM&lt;/b&gt; demo server&lt;br&gt;road distance, duration, route line&lt;br&gt;&lt;i&gt;Fair use: few calls, cached.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="225" width="230" height="90" as="geometry"/></mxCell><mxCell id="tiles" value="&lt;b&gt;tile.openstreetmap.org&lt;/b&gt;&lt;br&gt;map images, loaded by the browser&lt;br&gt;&lt;i&gt;Attribution « © OpenStreetMap ».&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="330" width="230" height="90" as="geometry"/></mxCell><mxCell id="zd" value="MySQL" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;dashed=1;" vertex="1" parent="1"><mxGeometry x="1010" y="470" width="260" height="150" as="geometry"/></mxCell><mxCell id="db" value="City: latitude, longitude (exist)&lt;br&gt;TripStop: meeting point coordinates, leg distance, duration, geometry (stored at publish)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B8C0CC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1025" y="505" width="230" height="100" as="geometry"/></mxCell><mxCell id="c1" value="fetch JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="leaf" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="api" target="clients"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;" edge="1" parent="1" source="api" target="rules"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;exitX=1;exitY=0.3;" edge="1" parent="1" source="clients" target="nom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;exitX=1;exitY=0.7;" edge="1" parent="1" source="clients" target="osrm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="leaf" target="tiles"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;" edge="1" parent="1" source="enr" target="clients"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;" edge="1" parent="1" source="enr" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="Solid: calls · Dashed: uses / reads · Yellow: new code, written test-first (Opus tests → Sonnet implementation → Opus review). Tests never call the real APIs: Symfony MockHttpClient replays saved responses." style="text;html=1;fontSize=12;fontColor=#5A626E;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="635" width="1230" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Publish sequence"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Publishing a trip with the map (suggestions, meeting point)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="36" as="geometry"/></mxCell><mxCell id="p_d" value="Driver" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FDF0E7;strokeColor=#E8A57F;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="170" height="48" as="geometry"/></mxCell><mxCell id="p_d_l" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" 