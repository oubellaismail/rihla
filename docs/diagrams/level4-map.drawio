urcePoint"/><mxPoint x="495" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="fills the field + hidden lat/lng" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="470" as="sourcePoint"/><mxPoint x="285" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="3. GET /api/route?points=Agadir;Essaouira;Marrakech" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="530" as="sourcePoint"/><mxPoint x="705" y="530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="miss → /route/v1/driving/…?overview=full" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="570" as="sourcePoint"/><mxPoint x="1335" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="legs: 175 km 2 h 05 · 190 km 2 h 40 + lines" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="610" as="sourcePoint"/><mxPoint x="705" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="PriceSuggester: 175 × 0.35 = 61 → &lt;b&gt;60 MAD&lt;/b&gt; · 190 × 0.35 = 66 → &lt;b&gt;65 MAD&lt;/b&gt;&lt;br&gt;ArrivalTimeSuggester: 08:00 + 2 h 05 + 10 min → &lt;b&gt;10:15&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#FFF8DD;strokeColor=#E2C76B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="625" y="640" width="400" height="36" as="geometry"/></mxCell><mxCell id="m14" value="legs[{distanceKm, durationMin, suggestedPrice, geometry}]" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="700" as="sourcePoint"/><mxPoint x="495" y="700" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="route + suggestions" style="rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="495" y="740" as="sourcePoint"/><mxPoint x="285" y="740" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15b" value="Shows the route and « Prix conseillé : 60 MAD » · « Heure conseillée : 10:15 » with a [Utiliser] button" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="738" width="330" height="36" as="geometry"/></mxCell><mxCell id="m16" value="4. « Publier le trajet » (POST /trips/new, CSRF)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;fontColor=#3A414C;fontSize=11;verticalAlign=bottom;labelBackgroundColor=default;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="800" as="sourcePoint"/><mxPoint x="1545" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="Level 3 checks unchanged (stops, times, seats, prices — the driver's prices win)" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=6;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1215" y="830" width="400" height="36" as="geometry"/></mxCell><mxCell id="m18" value="RouteEnricher → route (served from cache)" style="rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6B7686;