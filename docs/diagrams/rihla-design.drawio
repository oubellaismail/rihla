11"><mxGeometry x="1" relative="1" as="geometry"/></mxCell><mxCell id="leg" value="Blue: core entities · Purple: reference data (Nominatim cache) · Yellow: enums · ◆ composition (stops are deleted with their trip)" style="text;html=1;fontSize=12;fontColor=#5A626E;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="990" width="1050" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Booking lifecycle"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Booking lifecycle (BookingStatus)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="36" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;fillColor=#000000;strokeColor=none;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="c" value="CONFIRMED&lt;br&gt;&lt;small&gt;seats held on its legs&lt;/small&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="200" height="60" as="geometry"/></mxCell><mxCell id="d" value="COMPLETED&lt;br&gt;&lt;small&gt;reviews open 14 days&lt;/small&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=14;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="200" height="60" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="1000" y="95" width="30" height="30" as="geometry"/></mxCell><mxCell id="p" value="CANCELLED_BY_PASSENGER&lt;br&gt;&lt;small&gt;refund 100 % / 50 % / 0 %&lt;/small&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="240" height="60" as="geometry"/></mxCell><mxCell id="dr" value="CANCELLED_BY_DRIVER&lt;br&gt;&lt;small&gt;refund 100 %&lt;/small&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FDECEC;strokeColor=#EBA3A3;" vertex="1" parent="1"><mxGeometry x="400" y="280" width="240" height="60" as="geometry"/></mxCell><mxCell id="f2" value="" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="145" y="420" width="30" height="30" as="geometry"/></mxCell><mxCell id="f3" value="" style="ellipse;shape=endState;fillColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="505" y="420" width="30" height="30" as="geometry"/></mxCell><mxCell id="n" value="&lt;b&gt;Refund rules&lt;/b&gt;&lt;br&gt;Passenger: 100 % until 24 h before departure of their portion, 50 % after, 0 % once the car has left.&lt;br&gt;Driver cancels or removes the stop: 100 %.&lt;br&gt;Driver delays 30 min or more: passenger may cancel at 100 %." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF9DB;strokeColor=#E9D58A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="260" width="310" height="140" as="geometry"/></mxCell><mxCell id="a1" value="book" style="endArrow=open;endSize=10;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" parent="1" source="i" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="trip arrives" style="endArrow=open;endSize=10;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="after 14 days" style="endArrow=open;endSize=10;html=1;strokeColor=#8A94A6;fontColor=#5A626E;" edge="1" parent="1" source="d" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="passenger cancels" style="endArrow=open;endSize=10;html=1;strokeColor=#C9302C;fontColor=#C9302C;" edge="1" parent="1" source="c" target="p"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="driver cancels&lt;br&gt;or stop removed" style="endArrow=open;endSize=10;html=1;strokeColor=#C9302C;fontColor=#C9302C;" edge="1" parent="1" source="c" target="dr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="" style="endArrow=open;endSize=10;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="p" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="" style="endArrow=open;endSize=10;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="dr" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value='"book" = seats free on every leg, checked while the trip row is locked. A refused request never creates a booking. Red arrows = cancellations.' style="text;html=1;fontSize=12;fontColor=#5A626E;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="990" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Use cases"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Rihla — use case diagram" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="36" as="geometry"/></mxCell><mxCell id="sys" value="Rihla (web application)" style="swimlane;startSize=30;fillColor=#F7F8FA;strokeColor=#D5DAE1;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="60" width="660" height="620" as="geometry"/></mxCell><mxCell id="u1" value="Search trips" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="sys"><mxGeometry x="30" y="50" width="260" height="56" as="geometry"/></mxCell><mxCell id="u2" value="View a trip and its free seats per leg" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="sys"><mxGeometry x="30" 