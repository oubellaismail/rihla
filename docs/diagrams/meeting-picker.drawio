<mxfile host="drawio"><diagram name="Code changes"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Meeting-point picker — what changes in the code (screens: mockup canvas)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="36" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;MeetingPointRule&lt;/b&gt; (new, pure)&lt;br&gt;MAX_KM = 15&lt;br&gt;distanceKm(GeoPoint, GeoPoint): haversine&lt;br&gt;isNear(meeting, city): bool" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF8DD;strokeColor=#E2C76B;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;TripPublisher&lt;/b&gt;&lt;br&gt;+ check: a meeting point placed more than 15 km from its stop's city is refused:&lt;br&gt;« Le point de rendez-vous de Essaouira est à 32 km de la ville. »" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF8DD;strokeColor=#E2C76B;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="420" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;MapApiController&lt;/b&gt;&lt;br&gt;/api/geocode?q=&amp;amp;city={id}: searches « q, city », adds distanceKm and tooFar&lt;br&gt;/api/reverse?lat=&amp;amp;lng=&amp;amp;city={id}: same&lt;br&gt;/api/meeting-points?city={id} (new): up to 5 places already used by drivers in that city, most used first (real data, no invented list)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="460" height="120" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Publish page&lt;/b&gt;&lt;br&gt;each stop: place chosen + « Modifier » + « Retirer le point », or « Choisir sur la carte »&lt;br&gt;meeting-picker Stimulus controller: large dialog, map centred on the city, fixed centre pin, reverse after each move, suggestions, « Valider ce point » disabled when too far&lt;br&gt;right map: route preview only; without JS the text field still works" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="520" y="210" width="460" height="130" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Tests first (Opus)&lt;/b&gt;&lt;br&gt;• distance and 15 km rule (unit)&lt;br&gt;• TripPublisher refuses a far point, accepts a near one or none&lt;br&gt;• API: city-aware geocode/reverse, meeting-points from earlier trips&lt;br&gt;• publish page: picker markup, a far point is a 422 with the reason" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="420" height="110" as="geometry"/></mxCell><mxCell id="c7" value="uses" style="endArrow=open;dashed=1;html=1;strokeColor=#8A94A6;fontSize=11;" edge="1" parent="1" source="c3" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="uses" style="endArrow=open;dashed=1;html=1;strokeColor=#8A94A6;fontSize=11;" edge="1" parent="1" source="c4" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
