<mxfile host="drawio"><diagram name="Code changes"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c83" value="What changes in the code (test-first, as usual)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c84" value="&lt;b&gt;TripSummary&lt;/b&gt; (new, src/Model, built by a small service)&lt;br&gt;• passengersCarried, amountReceived, rating (RatingSummary of reviews about the driver on this trip)&lt;br&gt;• rows: completed bookings with the passenger's review and the driver's review" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF8DD;strokeColor=#E2C76B;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="420" height="110" as="geometry"/></mxCell><mxCell id="c85" value="&lt;b&gt;ReviewRepository&lt;/b&gt;&lt;br&gt;+ forTrip(Trip): reviews of its bookings (both directions)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF8DD;strokeColor=#E2C76B;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="420" height="60" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;DriverTripController::show&lt;/b&gt;&lt;br&gt;COMPLETED → template driver/finished.html.twig with the summary&lt;br&gt;CANCELLED → driver/cancelled.html.twig&lt;br&gt;PUBLISHED → unchanged" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="520" y="70" width="420" height="90" as="geometry"/></mxCell><mxCell id="c87" value="&lt;b&gt;BookingController&lt;/b&gt;&lt;br&gt;show: header, review card, driver's review; cancelled → refund line&lt;br&gt;review: when the author is the driver, redirect back to /driver/trips/{id}" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="420" height="80" as="geometry"/></mxCell><mxCell id="c88" value="&lt;b&gt;TripMapBuilder&lt;/b&gt;&lt;br&gt;Driver on a COMPLETED trip: seatsTaken = null (no occupancy colours, one dusk line). CANCELLED pages show no map.&lt;br&gt;&lt;i&gt;Replaces the occupancy shown on finished trips since the last fix (2 tests updated).&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF8DD;strokeColor=#E2C76B;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="420" height="70" as="geometry"/></mxCell><mxCell id="c89" value="&lt;b&gt;Tests first (Opus)&lt;/b&gt;&lt;br&gt;• summary numbers (carried, received without refunds, rating of this trip only)&lt;br&gt;• driver sees « Noter Mehdi », reviews, comes back; button gone afterwards&lt;br&gt;• no phone numbers on finished/cancelled pages&lt;br&gt;• cancelled pages show refunds; no map occupancy&lt;br&gt;• map data: no seatsTaken after the trip" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#E7F6EC;strokeColor=#8BCB9F;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="420" height="120" as="geometry"/></mxCell><mxCell id="c90" value="uses" style="endArrow=open;dashed=1;html=1;strokeColor=#8A94A6;fontSize=11;" edge="1" parent="1" source="c86" target="c84"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c91" value="" style="endArrow=open;dashed=1;html=1;strokeColor=#8A94A6;" edge="1" parent="1" source="c84" target="c85"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
