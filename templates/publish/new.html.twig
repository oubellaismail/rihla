{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% form_theme form 'form/rihla.html.twig' %}

{% block title %}Publier un trajet{% endblock %}

{% block body %}
<div class="container page">
    <div class="page-head">
        <h1>Publier un trajet</h1>
        <p>Ajoutez les villes où vous pouvez vous arrêter. Chaque arrêt permet à quelqu'un de monter ou de descendre, et remplit votre voiture plus longtemps.</p>
    </div>

    {{ form_start(form, {attr: {class: 'form', 'data-controller': 'stop-list publish-map meeting-picker', 'data-publish-map-cities-value': cityCoordinates|json_encode, 'data-meeting-picker-cities-value': cityCoordinates|json_encode, 'data-meeting-picker-max-km-value': constant('App\\Service\\Geo\\MeetingPointRule::MAX_KM'), 'data-stop-list-prototype-value': include('publish/_stop.html.twig', {stop: form.stops.vars.prototype}) ~ '', 'data-stop-list-index-value': form.stops|length}}) }}
        <div class="split">
            <div class="stack stack--l">
                {% for e in form.vars.errors %}<p class="flash flash--error" role="alert">{{ e.message }}</p>{% endfor %}

                <section class="card stack">
                    <h2 class="h2-s">Itinéraire</h2>
                    {{ form_errors(form.stops) }}
                    <ol class="stop-list" data-stop-list-target="list">
                        {% for stop in form.stops %}
                            {{ include('publish/_stop.html.twig', {stop: stop}) }}
                        {% endfor %}
                    </ol>
                    <div><button type="button" class="btn btn--outline" data-action="stop-list#add">{{ ui.icon('plus') }} Ajouter un arrêt</button></div>
                </section>

                <section class="card stack">
                    <h2 class="h2-s">Votre voiture</h2>
                    <div class="form-row">
                        {{ form_row(form.vehicle) }}
                        {{ form_row(form.seatsOffered) }}
                    </div>
                </section>
            </div>

            <aside class="price-box stack">
                <div class="map-slot map-slot--publish" data-publish-map-target="canvas">Carte de l'itinéraire</div>
                <p class="small muted">Aperçu de l'itinéraire. Les points de rendez-vous se choisissent arrêt par arrêt, avec le bouton « Choisir sur la carte ».</p>
                <p class="small muted" data-publish-map-target="note" hidden>Suggestions indisponibles pour le moment.</p>
                <p class="small muted">Vous fixez le prix par place de chaque tronçon. Un passager ne paie que la partie du trajet qu'il fait.</p>
                {{ form_widget(form.save, {attr: {class: 'btn btn--primary btn--block'}}) }}
            </aside>
        </div>

        <div class="picker-backdrop" data-meeting-picker-target="backdrop" hidden>
            <div class="picker" role="dialog" aria-modal="true" aria-labelledby="picker-title" data-meeting-picker-target="dialog">
                <div class="picker-side">
                    <div class="picker-head">
                        <button type="button" class="picker-close" data-action="meeting-picker#cancel" aria-label="Fermer et revenir au formulaire">{{ ui.icon('close', 20) }}</button>
                        <div class="picker-titles">
                            <span class="picker-eyebrow" data-meeting-picker-target="eyebrow"></span>
                            <h2 id="picker-title" data-meeting-picker-target="title">Rendez-vous</h2>
                        </div>
                    </div>
                    <div class="picker-search">
                        <label for="picker-search" data-meeting-picker-target="searchLabel">Chercher un lieu</label>
                        <div class="picker-search-row">
                            <input type="search" id="picker-search" autocomplete="off" placeholder="Gare routière, station, place…" data-meeting-picker-target="search" data-action="keydown->meeting-picker#searchKey">
                            <button type="button" class="btn btn--outline picker-go" data-action="meeting-picker#search">{{ ui.icon('search') }}<span class="visually-hidden">Chercher</span></button>
                        </div>
                        <p class="small muted picker-note" data-meeting-picker-target="note" role="status" hidden></p>
                        <ul class="picker-list" data-meeting-picker-target="results" aria-label="Résultats de la recherche" hidden></ul>
                    </div>
                    <div class="picker-popular" data-meeting-picker-target="popular" hidden>
                        <span class="picker-label" data-meeting-picker-target="popularLabel">Lieux souvent choisis</span>
                        <ul class="picker-list picker-list--chips" data-meeting-picker-target="popularList"></ul>
                    </div>
                    <p class="small muted picker-hint">Ou déplacez la carte : le point de rendez-vous est sous l'épingle, au centre.</p>
                </div>
                <div class="picker-map" data-meeting-picker-target="stage">
                    <div class="picker-canvas" data-meeting-picker-target="canvas" aria-label="Carte, déplacez-la pour placer l'épingle"></div>
                    <div class="picker-pin" aria-hidden="true">
                        <svg width="44" height="56" viewBox="0 0 44 56"><path d="M22 54s-18-16-18-30a18 18 0 0 1 36 0c0 14-18 30-18 30z" stroke="#FFFFFF" stroke-width="3"/><circle cx="22" cy="23" r="7" fill="#FFFFFF"/></svg>
                    </div>
                    <div class="picker-pin-shadow" aria-hidden="true"></div>
                    <div class="picker-card">
                        <div class="picker-status" role="status" aria-live="polite">
                            <span class="picker-eyebrow">Point de rendez-vous</span>
                            <strong class="picker-address" data-meeting-picker-target="address">Déplacez la carte</strong>
                            <span class="picker-far" data-meeting-picker-target="far" hidden>{{ ui.icon('alert') }}<span data-meeting-picker-target="farText"></span></span>
                            <span class="picker-detail" data-meeting-picker-target="detail"></span>
                        </div>
                        <div class="picker-actions">
                            <button type="button" class="btn btn--outline" data-action="meeting-picker#cancel">Annuler</button>
                            <button type="button" class="btn btn--primary" data-action="meeting-picker#validate" data-meeting-picker-target="validate" disabled>Valider ce point</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
