{# One stop of the trip form; also used for the prototype (see stop_list_controller.js). #}
{% import 'macros.html.twig' as ui %}
<li class="stop-row" data-stop-list-target="item">
    <div class="stop-head">
        <strong class="stop-label" data-stop-list-target="label">Arrêt</strong>
        <button type="button" class="btn btn--ghost stop-remove" data-action="stop-list#remove" data-stop-list-target="removeButton" aria-label="Retirer cet arrêt">{{ ui.icon('trash') }} Retirer</button>
    </div>
    {% for e in stop.vars.errors %}<p class="flash flash--error" role="alert">{{ e.message }}</p>{% endfor %}
    <div class="form-row">
        {{ form_row(stop.city) }}
        {{ form_row(stop.departureAt) }}
    </div>
    <p class="small suggestion" data-role="time-suggestion" hidden></p>
    <div class="stop-meeting" data-role="meeting">
        <div class="meeting-ui">
            <div class="meeting-empty" data-role="meeting-empty">
                <span class="meeting-text" data-role="meeting-text">Point de rendez-vous à choisir</span>
                <button type="button" class="btn btn--outline meeting-open" data-action="meeting-picker#open" data-role="meeting-choose">{{ ui.icon('map') }} Choisir sur la carte</button>
            </div>
            <div class="meeting-placed" data-role="meeting-placed" hidden>
                <span class="meeting-place">{{ ui.icon('pin') }}<strong data-role="meeting-label"></strong></span>
                <button type="button" class="btn btn--outline meeting-open" data-action="meeting-picker#open" data-role="meeting-edit">Modifier</button>
                <button type="button" class="btn btn--ghost meeting-clear" data-action="meeting-picker#clear">Retirer le point</button>
            </div>
        </div>
        {{ form_row(stop.meetingPoint) }}
    </div>
    {{ form_widget(stop.meetingLatitude) }}
    {{ form_widget(stop.meetingLongitude) }}
    <div class="stop-price" data-stop-list-target="price">
        {{ form_row(stop.legPriceToNext, {attr: {placeholder: 'Prix conseillé après le choix des villes'}}) }}
        <p class="small suggestion" data-role="price-suggestion" hidden></p>
    </div>
</li>
