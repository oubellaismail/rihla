{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}
{% block title %}Trajet {{ trip.firstStop.city.name }} → {{ trip.lastStop.city.name }}{% endblock %}
{% block body %}
<div class="page"><div class="container">
    <div class="page-head">
        <p class="muted small"><a href="{{ path('app_driver_trips') }}">Mes trajets</a></p>
        <h1>{{ trip.firstStop.city.name }} → {{ trip.lastStop.city.name }}</h1>
        <p class="row">{{ trip.firstStop.departureAt|format_datetime(pattern: 'EEEE d MMMM') }}
            <span class="badge {{ trip.status.value == 'PUBLISHED' ? 'badge--ok' : (trip.status.value == 'CANCELLED' ? 'badge--off' : '') }}">{{ trip.status.label }}</span>
            <a href="{{ path('app_trip_show', {id: trip.id}) }}">Voir la page publique</a></p>
    </div>

    <div class="driver-trip">
        <div class="driver-trip__main">
            <section class="card stack">
                <h2 class="section-title">Carte du trajet</h2>
                <div class="map-slot map-slot--trip" data-controller="trip-map" data-trip-map-data-value="{{ map|json_encode }}">Carte du trajet</div>
            </section>

            <section class="card stack">
                <h2 class="section-title">Arrêts et passagers</h2>
                <ol class="timeline">
                    {% for stop in stops %}
                        {% set pos = stop.position %}
                        <li>
                            <time>{{ stop.departureAt|date('H:i') }}</time>
                            <span class="dot"></span>
                            <div>
                                <div class="stop-city">{{ stop.city.name }}</div>
                                {% if stop.meetingPoint %}<div class="stop-meta">{{ stop.meetingPoint }}</div>{% endif %}
                                {% for b in boarding[pos] ?? [] %}
                                    <div class="passenger">
                                        {{ ui.avatar(b.passenger) }}
                                        <div>
                                            <strong>{{ b.passenger.publicName }}</strong>
                                            <span class="muted small">jusqu'à {{ b.toStop.city.name }} · {{ b.seats }} {{ b.seats > 1 ? 'places' : 'place' }}</span>
                                            {% set seatCodes = seats_of(b) %}<span class="small">{{ seatCodes|length > 1 ? 'Places' : 'Place' }} {{ seatCodes|seat_list }}</span>
                                            {% if b.passenger.phone %}<div class="small"><a href="tel:{{ b.passenger.phone }}">{{ b.passenger.phone }}</a></div>{% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {% if not loop.last %}
                                {% set t = taken[pos] ?? 0 %}
                                {% set free = trip.seatsOffered - t %}
                                <span class="leg-seats {{ free <= 0 ? 'is-full' : (free == 1 ? 'is-warn' : '') }}">{{ t }} / {{ trip.seatsOffered }} places</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </section>
        </div>
        <aside class="driver-trip__side">
            <section class="card trunk-plan" aria-labelledby="trunk-title">
                <div class="trunk-plan__head">
                    <h2 id="trunk-title" class="section-title">Le coffre, arrêt par arrêt</h2>
                    <p class="trunk-plan__lede">À chaque arrêt, rendez d'abord les bagages, puis rangez les nouveaux. Cochez au fur et à mesure.</p>
                </div>
                {% if not trunk.hasBags %}
                    <p class="muted">Aucun bagage déclaré pour l'instant.</p>
                {% else %}
                    {% set bagIcon = {cabin: 16, medium: 20, large: 24} %}
                    <ol class="trunk-stops">
                        {% for entry in trunk.stops %}
                            <li class="trunk-stop">
                                <div class="trunk-stop__head">
                                    <span class="trunk-stop__dot" aria-hidden="true"></span>
                                    <strong class="trunk-stop__city">{{ entry.stop.city.name }}</strong>
                                    <time class="muted">{{ entry.stop.departureAt|date('H:i') }}</time>
                                </div>
                                <div class="trunk-stop__body">
                                    {% if entry.unload is not empty %}
                                        <div class="trunk-task">
                                            <p class="trunk-task__verb trunk-task__verb--out">{{ ui.icon('arrow', 18) }} {{ entry.load is empty ? 'Rendre' : "Rendre d'abord" }}</p>
                                            <ul class="trunk-task__list">
                                                {% for u in entry.unload %}
                                                    <li><label class="trunk-check"><input type="checkbox">
                                                        <span class="trunk-check__bags" aria-hidden="true">{% for s in u.sizes %}{{ ui.icon('suitcase', bagIcon[s]) }}{% endfor %}</span>
                                                        <span class="trunk-check__text">{{ u.name }} : {{ u.bags }}</span>
                                                    </label></li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}
                                    {% if entry.load is not empty %}
                                        <div class="trunk-task">
                                            <p class="trunk-task__verb trunk-task__verb--in">{{ ui.icon('plus', 18) }} {{ entry.unload is empty ? 'Ranger' : 'Puis ranger' }}</p>
                                            <ul class="trunk-task__list">
                                                {% for l in entry.load %}
                                                    <li><label class="trunk-check"><input type="checkbox">
                                                        <span class="trunk-check__bags" aria-hidden="true">{% for s in l.sizes %}{{ ui.icon('suitcase', bagIcon[s]) }}{% endfor %}</span>
                                                        <span class="trunk-check__text">{{ l.name }} : {{ l.bags }}<span class="trunk-check__to">descend à {{ l.to }}{% if l.back %}, <strong>à mettre au fond</strong>{% endif %}</span></span>
                                                    </label></li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                    {% endif %}
                                    {% if entry.next %}
                                        <p class="trunk-state"><strong>{{ entry.next.fullness }}</strong> jusqu'à {{ entry.next.city }}.
                                            {{ entry.next.room == 'plein' ? 'Plus de place pour un bagage.' : ('Il reste de la ' ~ entry.next.room ~ '.') }}
                                            <span class="trunk-state__litres">({{ entry.next.litres }} L sur {{ trunk.usable }} L)</span></p>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ol>
                    <p class="trunk-plan__note small muted">Rihla compte {{ trunk.usable }} L sur les {{ trip.trunkLitres }} L de la {{ trip.vehicle.model }} : des valises rigides ne remplissent jamais tous les coins.</p>
                {% endif %}
            </section>

            {% if cancelled is not empty %}
            <section class="stack booking-past">
                <h2 class="section-title">Réservations annulées</h2>
                <ul class="cancelled-list">
                    {% for b in cancelled %}
                        <li class="muted">{{ b.passenger.publicName }} · {{ b.fromStop.city.name }} → {{ b.toStop.city.name }} · {{ b.seats }} {{ b.seats > 1 ? 'places' : 'place' }}</li>
                    {% endfor %}
                </ul>
            </section>
            {% endif %}

            {% if can_cancel %}
            <section class="card stack">
                <h2 class="section-title">Annuler le trajet</h2>
                <p class="muted">Tous les passagers ayant réservé seront remboursés à 100 %.</p>
                <form method="post" action="{{ path('app_driver_trip_cancel', {id: trip.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_trip_' ~ trip.id) }}">
                    <button type="submit" class="btn btn--danger">Annuler le trajet</button>
                </form>
            </section>
            {% endif %}
        </aside>
    </div>
</div></div>
{% endblock %}
