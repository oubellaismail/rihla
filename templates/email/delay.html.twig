{% extends 'email/layout.html.twig' %}
{% block title %}{{ subject }}{% endblock %}
{% block content %}
<p style="margin:0 0 16px;">{{ driverFirstName }} a décalé son trajet de {{ delay }}.</p>
<div style="background:#fbf3e4;border-left:4px solid #f2a541;padding:12px 16px;margin:0 0 16px;">
    {{ city }}, {{ meetingPoint }} — {{ newTime }} au lieu de {{ oldTime }}, {{ date }}
</div>
{% if freeCancel %}<p style="margin:0 0 16px;">Ce retard dépasse 30 min : vous pouvez annuler sans frais et être remboursé(e) intégralement.</p>{% endif %}
{% endblock %}
{% block button %}{% include 'email/_button.html.twig' with {url: bookingUrl, label: 'Voir ma réservation'} %}{% endblock %}
