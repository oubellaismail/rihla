<!doctype html>
<html lang="fr">
<head><meta charset="utf-8"><title>{% block title %}Rihla{% endblock %}</title></head>
<body style="margin:0;padding:0;background:#fbf3e4;font-family:Arial,Helvetica,sans-serif;color:#2b2a33;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#fbf3e4;padding:24px 12px;">
<tr><td align="center">
    <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="max-width:560px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;">
        <tr><td style="background:#f2a541;padding:20px 28px;font-size:26px;font-weight:bold;letter-spacing:1px;color:#2b2a33;">Rihla</td></tr>
        <tr><td style="padding:28px;font-size:16px;line-height:1.5;">
            <p style="margin:0 0 16px;">Bonjour {{ firstName }},</p>
            {% block content %}{% endblock %}
            {% block button %}{% endblock %}
        </td></tr>
        <tr><td style="padding:16px 28px;background:#f7e4c2;font-size:12px;color:#6b5b45;">Rihla, le covoiturage entre les villes du Maroc.</td></tr>
    </table>
</td></tr>
</table>
</body>
</html>
