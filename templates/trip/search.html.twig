{% extends 'base.html.twig' %}
{% import 'macros.html.twig' as ui %}

{% macro card(result, wholeTrip = false) %}
    {% import 'macros.html.twig' as ui %}
    {% set match = result.match %}
    {% set trip = match.trip %}
    <a class="card card--link result{{ wholeTrip ? ' result--whole' : '' }}{{ match.full ? ' result--full' : '' }}" href="/trips/{{ trip.id }}{{ wholeTrip ? '' : '?from=' ~ match.from.position ~ '&amp;to=' ~ match.to.position }}">
        {% set first = trip.firstStop %}
        {% set last = trip.lastStop %}
        <ol class="result-timeline">
            {% if not wholeTrip and match.from.position != first.position %}
                <li class="result-stop result-stop--before">
                    <time class="result-stop__time" datetime="{{ first.departureAt|date('c') }}">{{ first.departureAt|date('H:i') }}</time>
                    <span class="result-stop__dot"></span>
                    <span class="result-stop__body">{{ first.city.name }} <span class="result-stop__note">Départ de la voiture</span></span>
                </li>
            {% endif %}
            <li class="result-stop result-stop--boarding">
                <time class="result-stop__time" datetime="{{ match.from.departureAt|date('c') }}">{{ match.from.departureAt|date('H:i') }}</time>
                <span class="result-stop__dot"></span>
                <span class="result-stop__body"><strong>{{ match.from.city.name }}</strong><span class="result-stop__note">{{ match.from.meetingPoint }}</span></span>
                <span class="result-duration">{{ match.from.departureAt|duration(match.to.departureAt) }}</span>
            </li>
            {% if wholeTrip %}
                {% for stop in trip.stops %}{% if not loop.first and not loop.last %}
                    <li class="result-stop result-stop--via">
                        <time class="result-stop__time" datetime="{{ stop.departureAt|date('c') }}">{{ stop.departureAt|date('H:i') }}</time>
                        <span class="result-stop__dot"></span>
                        <span class="result-stop__body">{{ stop.city.name }}</span>
                    </li>
                {% endif %}{% endfor %}
            {% endif %}
            <li class="result-stop result-stop--drop-off">
                <time class="result-stop__time" datetime="{{ match.to.departureAt|date('c') }}">{{ match.to.departureAt|date('H:i') }}</time>
                <span class="result-stop__dot"></span>
                <span class="result-stop__body"><strong>{{ match.to.city.name }}</strong></span>
            </li>
            {% if not wholeTrip and match.to.position != last.position %}
                <li class="result-stop result-stop--after">
                    <time class="result-stop__time" datetime="{{ last.departureAt|date('c') }}">{{ last.departureAt|date('H:i') }}</time>
                    <span class="result-stop__dot"></span>
                    <span class="result-stop__body">{{ last.city.name }} <span class="result-stop__note">Terminus</span></span>
                </li>
            {% endif %}
        </ol>
        <div class="result-driver">
            {{ ui.avatar(trip.driver) }}
            <span class="result-driver__name">
                <strong>{{ trip.driver.publicName }}</strong>
                <span class="small">{{ ui.rating(result.rating) }}</span>
                <span class="small muted">{{ trip.vehicle.model }} {{ trip.vehicle.color }}</span>
            </span>
        </div>
        <div class="result-price">
            {% if wholeTrip %}
                <span>dès <strong class="num">{{ match.cheapestLegPrice }} MAD</strong></span>
                <span class="small muted">{{ match.full ? 'Complet' : (match.partlyFree ? 'Places sur une partie du trajet' : (match.freeSeats ~ ' ' ~ (match.freeSeats > 1 ? 'places libres' : 'place libre'))) }}</span>
            {% elseif match.full %}
                <span class="result-full-label small">Complet sur votre portion</span>
            {% else %}
                <strong class="num">{{ match.pricePerSeat }} MAD</strong>
                <span class="small muted">{{ match.freeSeats }} {{ match.freeSeats > 1 ? 'places libres' : 'place libre' }}</span>
            {% endif %}
        </div>
        <div class="result-trunk">
            {% include 'luggage/_trunk_line.html.twig' with {trunk: trunk_line(trip, match.from, match.to)} only %}
        </div>
    </a>
{% endmacro %}

{% macro sort(criteria, base) %}
    <nav class="search-sort" aria-label="Tri des résultats">
        <span class="search-sort__label">Trier :</span>
        {% for key, label in {departure: 'Départ le plus tôt', price: 'Prix le plus bas', rating: 'Mieux noté'} %}
            <a href="{{ path('app_trip_search', base|merge(criteria.toQuery(key))) }}"{% if criteria.sort == key %} aria-current="true"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>
{% endmacro %}

{% block title %}Rechercher un trajet{% endblock %}

{% block body %}
<div class="container page">
    {% set searchForm %}
        <form class="searchbar" action="{{ path('app_trip_search') }}" method="get" role="search">
            <label><span>Départ</span><input type="text" name="from" value="{{ from }}" list="city-names" autocomplete="off" required></label>
            <label><span>Arrivée</span><input type="text" name="to" value="{{ to }}" list="city-names" autocomplete="off" required></label>
            <label><span>Quand</span><input type="date" name="date" value="{{ date ? date|date('Y-m-d') : '' }}"></label>
            <label><span>Passagers</span>
                <select name="seats">{% for n in 1..4 %}<option value="{{ n }}"{% if n == seats %} selected{% endif %}>{{ n }} passager{{ n > 1 ? 's' : '' }}</option>{% endfor %}</select>
            </label>
            <button class="btn btn--primary" type="submit">{{ ui.icon('search') }} Rechercher</button>
            <datalist id="city-names">{% for name in cityNames %}<option value="{{ name }}">{% endfor %}</datalist>
        </form>
    {% endset %}

    {% if searched %}
        <details class="search-summary" data-controller="search-summary">
            <summary>
                <span class="search-summary__text">{{ from|capitalize }} → {{ to|capitalize }} · {{ date ? date|format_datetime(pattern: 'EEE d MMM') : 'Prochains jours' }} · {{ seats }} {{ seats > 1 ? 'passagers' : 'passager' }}</span>
                <span class="search-summary__edit">Modifier</span>
            </summary>
            {{ searchForm }}
        </details>
    {% else %}
        {{ searchForm }}
    {% endif %}

    <div class="search-results stack stack--l">
        {% if not searched %}
            <div class="page-head">
                <h1>Prochains départs</h1>
                <p>Les trajets annoncés par les conducteurs, avec toutes leurs étapes : vous ne payez que votre portion.</p>
            </div>
            {% if upcomingTotal == 0 %}
                <div class="empty card">
                    <h2>Aucun départ annoncé pour le moment</h2>
                    <p>Vous faites la route bientôt ? Publiez votre trajet, les passagers viendront à vous.</p>
                    <a class="btn btn--primary" href="{{ path('app_trip_new') }}">Publier un trajet</a>
                </div>
            {% else %}
                {% set base = {} %}
                <div class="search-layout">
                    {% set clearUrl = path('app_trip_search') %}
                    {% include 'trip/_filters.html.twig' %}

                    <div class="search-main stack stack--l">
                        {{ _self.sort(criteria, base) }}
                        {% if upcoming is empty %}
                            <div class="empty card">
                                <h2>Aucun trajet ne correspond à vos filtres.</h2>
                                <p>Des départs sont annoncés : élargissez votre recherche.</p>
                                <a class="btn btn--outline search-filters__clear" href="{{ clearUrl }}">Effacer les filtres</a>
                            </div>
                        {% elseif criteria.sort != 'departure' %}
                            {% for result in upcoming %}{{ _self.card(result, true) }}{% endfor %}
                        {% else %}
                            {% for day in upcomingDays %}
                                <section class="upcoming-day stack">
                                    <h2 class="upcoming-day__title">{{ day.title }}</h2>
                                    {% for result in day.rows %}{{ _self.card(result, true) }}{% endfor %}
                                </section>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% elseif unknownCity %}
            <div class="empty card">
                <h2>Aucun trajet pour « {{ unknownCity }} »</h2>
                <p>Cette ville n’est pas encore desservie sur Rihla. Vérifiez l’orthographe ou choisissez une ville dans la liste proposée.</p>
            </div>
        {% elseif found > 0 %}
            {% set base = {from: from, to: to}|merge(date ? {date: date|date('Y-m-d')} : {})|merge({seats: seats}) %}
            <div class="page-head">
                <h1>{{ results|length == 0 ? 'Aucun trajet' : (results|length == 1 ? '1 trajet' : results|length ~ ' trajets') }}{% if date %} {{ date|format_datetime(pattern: 'EEEE d MMMM') }}{% endif %}</h1>
                <p>{{ from|capitalize }} vers {{ to|capitalize }}</p>
            </div>
            <div class="search-layout">
                {% set clearUrl = path('app_trip_search', base) %}
                {% include 'trip/_filters.html.twig' %}

                <div class="search-main stack stack--l">
                    {{ _self.sort(criteria, base) }}
                    {% if results is empty %}
                        <div class="empty card">
                            <h2>Aucun trajet ne correspond à vos filtres.</h2>
                            <p>Des trajets existent sur cette route : élargissez votre recherche.</p>
                            <a class="btn btn--outline search-filters__clear" href="{{ path('app_trip_search', base) }}">Effacer les filtres</a>
                        </div>
                    {% elseif date or criteria.sort != 'departure' %}
                        {% for result in results %}{{ _self.card(result) }}{% endfor %}
                    {% else %}
                        {% for day in resultDays %}
                            <section class="upcoming-day stack">
                                <h2 class="upcoming-day__title">{{ day.title }}</h2>
                                {% for result in day.rows %}{{ _self.card(result) }}{% endfor %}
                            </section>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="empty card">
                <h2>{{ date ? 'Aucun trajet ce jour-là' : 'Aucun trajet prochainement' }}</h2>
                <p>Aucun conducteur n’a annoncé {{ from|capitalize }} vers {{ to|capitalize }}{% if date %} le {{ date|format_datetime(pattern: 'd MMMM') }}{% else %} dans les 30 prochains jours{% endif %}. Essayez un autre jour, ou publiez vous-même le trajet.</p>
                <div class="row">
                    {% if date %}<a class="btn btn--outline" href="{{ path('app_trip_search', {from: from, to: to, date: date.modify('+1 day')|date('Y-m-d'), seats: seats}) }}">Voir le lendemain</a>{% endif %}
                    <a class="btn btn--outline" href="{{ path('app_trip_new') }}">Publier ce trajet</a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
