{# Small reusable pieces of UI. Icons are inline SVG, never emoji. #}

{% macro logo(width = 44) %}
<svg width="{{ width }}" height="{{ (width * 0.6)|round }}" viewBox="0 0 900 540" aria-hidden="true"><path d="M182 448 C 292 448, 352 400, 397 330" fill="none" stroke="#22305C" stroke-width="60"/><path d="M500 200 C 560 125, 620 87, 712 87" fill="none" stroke="#22305C" stroke-width="60"/><circle cx="85" cy="443" r="80" fill="#22305C"/><circle cx="445" cy="265" r="80" fill="#22305C"/><circle cx="807" cy="87" r="80" fill="#E8743B"/></svg>
{% endmacro %}

{# Initials on a coloured disc; the colour is stable for a given user. #}
{% macro avatar(user, size = '') %}
{% set tones = ['', 'avatar--warm', 'avatar--gold'] %}
<span class="avatar {{ tones[(user.id ?? 0) % 3] }} {{ size }}" aria-hidden="true">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
{% endmacro %}

{% macro arrow() %}
<svg width="22" height="11" viewBox="0 0 26 12" role="img" aria-label="vers"><path d="M1 6h22M18 1.5L24 6l-6 4.5" fill="none" stroke="#E8743B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{% endmacro %}

{% macro stars(rating) %}
<span class="stars" role="img" aria-label="{{ rating }} sur 5">
{% for i in 1..5 %}<svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2L2.9 9.4l6.3-.9z" fill="{{ i <= rating ? '#F2B544' : 'none' }}" stroke="#C98B1E" stroke-width="1.2" stroke-linejoin="round"/></svg>{% endfor %}
</span>
{% endmacro %}

{% macro rating(summary) %}
{% if summary.count > 0 %}
<span class="rating"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.2L12 17l-5.6 3 1.1-6.2L2.9 9.4l6.3-.9z" fill="#F2B544" stroke="#C98B1E" stroke-width="1.2" stroke-linejoin="round"/></svg>{{ summary.average|number_format(1, ',') }} <span class="muted">({{ summary.count }} avis)</span></span>
{% else %}
<span class="rating muted">Nouveau sur Rihla</span>
{% endif %}
{% endmacro %}

{% macro icon(name, size = 18) %}
{% set paths = {
    plus: '<path d="M12 5v14M5 12h14"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
    seat: '<path d="M7 4h6a3 3 0 0 1 3 3v6H9a2 2 0 0 1-2-2z"/><path d="M5 13h13l1 5H6z"/><path d="M8 18v2M17 18v2"/>',
    car: '<path d="M5 17h14M6 17l1.5-5.5A2 2 0 0 1 9.4 10h5.2a2 2 0 0 1 1.9 1.5L18 17"/><path d="M4 17v2h3v-2M17 17v2h3v-2"/>',
    pin: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
    calendar: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/>',
    check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    map: '<path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/>',
    close: '<path d="M6 6l12 12M18 6L6 18"/>',
    alert: '<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.5h.01"/>',
    suitcase: '<rect x="4" y="8" width="16" height="11" rx="2"/><path d="M9 8V6a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M9 12v4M15 12v4"/>',
    backpack: '<path d="M8 7a4 4 0 0 1 8 0"/><rect x="5" y="7" width="14" height="14" rx="3"/><path d="M9 14h6M9 11h6"/>',
    trash: '<path d="M5 7h14M10 7V5h4v2M7 7l1 13h8l1-13"/>',
} %}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths[name]|raw }}</svg>
{% endmacro %}

{% macro route(fromCity, toCity) %}
<span class="route">{{ fromCity }}{{ _self.arrow() }}{{ toCity }}</span>
{% endmacro %}
