<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Covoiturage entre les villes du Maroc{% endblock %} · Rihla</title>
        <meta name="description" content="{% block description %}Trouvez une place dans une voiture qui fait déjà la route. Vous ne payez que votre bout de trajet.{% endblock %}">
        <link rel="icon" href="{{ asset('images/rihla-icon.svg') }}" type="image/svg+xml">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% import 'macros.html.twig' as ui %}
        {% set route = app.request.attributes.get('_route') %}
        {% set space = app.user ? current_space() : null %}
        {% if space == 'driver' %}
            {% set menu = [
                {href: path('app_driver_dashboard'), label: 'Tableau de bord', short: 'Accueil', routes: ['app_driver_dashboard']},
                {href: path('app_driver_trips'), label: 'Mes trajets', short: 'Trajets', routes: ['app_driver_trips', 'app_driver_trip_show', 'app_driver_trip_cancel']},
                {href: path('app_driver_earnings'), label: 'Mes gains', short: 'Gains', routes: ['app_driver_earnings']},
            ] %}
        {% else %}
            {% set menu = [
                {href: path('app_trip_search'), label: 'Rechercher', routes: ['app_trip_search', 'app_trip_show', 'app_trip_seats', 'app_trip_book']},
                {href: path('app_booking_index'), label: 'Mes réservations', short: 'Réservations', routes: ['app_booking_index', 'app_booking_show', 'app_booking_cancel', 'app_booking_review']},
            ] %}
        {% endif %}
        <header class="site-header">
            <nav class="container" aria-label="Navigation principale">
                <a class="brand" href="{{ path('app_home') }}" aria-label="Rihla, accueil">
                    {{ ui.logo(44) }}
                    <span>Rihla</span>
                </a>
                <div class="nav-links">
                    {% if app.user %}
                        <span class="space-links">
                            {% for item in menu %}
                                <a href="{{ item.href }}" {% if route in item.routes %}aria-current="page"{% endif %}>{% if item.short is defined %}<span class="hide-sm">{{ item.label }}</span><span class="show-sm">{{ item.short }}</span>{% else %}{{ item.label }}{% endif %}</a>
                            {% endfor %}
                        </span>
                        <a class="btn btn--outline" href="{{ path('app_trip_new') }}" {% if route == 'app_trip_new' %}aria-current="page"{% endif %}>{{ ui.icon('plus') }} <span class="hide-sm">Publier un trajet</span><span class="visually-hidden-sm">Publier un trajet</span></a>
                        <div class="space-switch" role="group" aria-label="Espace">
                            <a href="{{ path('app_trip_search') }}" {% if space == 'passenger' %}aria-current="true"{% endif %}>Passager</a>
                            <a href="{{ path('app_driver_dashboard') }}" {% if space == 'driver' %}aria-current="true"{% endif %}>Conducteur</a>
                        </div>
                        <details class="menu">
                            <summary aria-label="Menu du compte">{{ ui.avatar(app.user) }}</summary>
                            <div class="menu-panel">
                                <div class="menu-who"><strong>{{ app.user.fullName }}</strong><br><span class="small muted">{{ app.user.email }}</span></div>
                                <a href="{{ path('app_user_profile', {id: app.user.id}) }}">Mon profil public</a>
                                <a href="{{ path('app_account') }}">Mon compte</a>
                                <a href="{{ path('app_vehicles') }}">Mes véhicules</a>
                                {% if is_granted('ROLE_ADMIN') %}<a href="{{ path('admin') }}">Back-office</a>{% endif %}
                                <a href="{{ path('app_logout') }}">Déconnexion</a>
                            </div>
                        </details>
                    {% else %}
                        <a href="{{ path('app_trip_search') }}" {% if route == 'app_trip_search' %}aria-current="page"{% endif %}>Rechercher</a>
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a class="btn btn--outline" href="{{ path('app_register') }}">Inscription</a>
                    {% endif %}
                </div>
            </nav>
        </header>

        {% set flashes = app.flashes(['success', 'error', 'info']) %}
        {% if flashes|filter(m => m is not empty)|length %}
            <div class="container">
                <div class="flashes">
                    {% for type, messages in flashes %}
                        {% for message in messages %}<p class="flash flash--{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</p>{% endfor %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <main id="contenu">
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container footer-grid">
                <div class="stack stack--tight">
                    <a class="brand" href="{{ path('app_home') }}" aria-label="Rihla, accueil">
                        {{ ui.logo(40) }}
                        <span class="footer-brand">Rihla</span>
                    </a>
                    <span>Covoiturage régional au Maroc, tronçon par tronçon.</span>
                </div>
                <nav class="stack stack--tight" aria-label="Voyager">
                    <strong>Voyager</strong>
                    <a href="{{ path('app_trip_search') }}">Prochains départs</a>
                    <a href="{{ path('app_home') }}#principe">Comment ça marche</a>
                    <a href="{{ path('app_home') }}#avis">Avis passagers</a>
                </nav>
                <nav class="stack stack--tight" aria-label="Conduire">
                    <strong>Conduire</strong>
                    <a href="{{ path('app_trip_new') }}">Publier un trajet</a>
                    <a href="{{ path('app_home') }}#confiance">Confiance et sécurité</a>
                </nav>
                <div class="stack stack--tight">
                    <strong>À propos</strong>
                    <span>Projet réalisé pour l’EMC PFE Challenge 2026.</span>
                    <span>Photos générées par IA.</span>
                </div>
            </div>
            <div class="container footer-bottom">© 2026 Rihla. Bonne route.</div>
        </footer>
    </body>
</html>
